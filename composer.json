{
    "name": "justbetter/statamic-replicator-transfer",
    "description": "Transfer Statamic replicator content between entries.",
    "type": "package",
    "license": "MIT",
    "authors": [
        {
            "name": "Bob Wezelman",
            "email": "bob@justbetter.nl"
        }
    ],
    "autoload": {
        "psr-4": {
            "JustBetter\\ReplicatorTransfer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustBetter\\ReplicatorTransfer\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0|^13.0",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.8|^11.0",
        "phpstan/phpstan-mockery": "^2.0",
        "rector/rector": "^2.3"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic Replicator Transfer",
            "description": "Statamic Replicator Transfer addon"
        },
        "laravel": {
            "providers": [
                "JustBetter\\ReplicatorTransfer\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan --memory-limit=256M",
        "style": "pint --test",
        "quality": [
            "@style",
            "@analyse",
            "@test",
            "@coverage",
            "@rector"
        ],
        "coverage": "XDEBUG_MODE=coverage php -d memory_limit=2G vendor/bin/phpunit --coverage-text --only-summary-for-coverage-text | grep -c \"100.00%\" | grep -q \"^3$\" && exit 0 || exit 1",
        "rector": "rector process --dry-run"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
